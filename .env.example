# LLM-Powered Network Analyzer - Environment Configuration
# Copy this file to .env and modify the values as needed

# Application Settings
APP_NAME="LLM-Powered Network Analyzer"
APP_VERSION="1.0.0"
DEBUG=false

# Server Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
FRONTEND_HOST=localhost
FRONTEND_PORT=4200

# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma2:12b

# API Configuration
API_TIMEOUT=300
MAX_FILE_SIZE=524288000  # 500MB in bytes
UPLOAD_TIMEOUT=60

# WebSocket Configuration
WS_TIMEOUT=1800  # 30 minutes
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Analysis Configuration
MAX_CONCURRENT_ANALYSES=3
CHUNK_SIZE=4000
ANALYSIS_TIMEOUT=1800  # 30 minutes

# Security Configuration
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=your-secret-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
MAX_LOG_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance Configuration
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65

# Database Configuration (if needed for future features)
# DATABASE_URL=sqlite:///./network_analyzer.db

# Redis Configuration (if needed for caching)
# REDIS_URL=redis://localhost:6379/0

# Monitoring Configuration
ENABLE_METRICS=false
METRICS_PORT=9090

# Feature Flags
ENABLE_TEST_DATA_GENERATION=true
ENABLE_EXPORT_FUNCTIONALITY=true
ENABLE_BATCH_ANALYSIS=false

# Development Settings
DEV_MODE=false
HOT_RELOAD=false
MOCK_LLM_RESPONSES=false

# Production Settings
PRODUCTION=false
SSL_ENABLED=false
SSL_CERT_PATH=""
SSL_KEY_PATH=""

# Docker Configuration
DOCKER_BACKEND_IMAGE=network-analyzer/backend:latest
DOCKER_FRONTEND_IMAGE=network-analyzer/frontend:latest
DOCKER_NETWORK=network-analyzer-net

# Kubernetes Configuration
K8S_NAMESPACE=network-analyzer
K8S_REPLICAS_BACKEND=3
K8S_REPLICAS_FRONTEND=2
K8S_REPLICAS_OLLAMA=2

# Resource Limits
MEMORY_LIMIT_BACKEND=8Gi
CPU_LIMIT_BACKEND=4
MEMORY_LIMIT_FRONTEND=1Gi
CPU_LIMIT_FRONTEND=1
MEMORY_LIMIT_OLLAMA=32Gi
CPU_LIMIT_OLLAMA=8

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Alert Configuration
ALERT_EMAIL=""
ALERT_WEBHOOK=""
ALERT_SLACK_WEBHOOK=""

# Analytics Configuration (privacy-focused, local only)
ENABLE_USAGE_ANALYTICS=false
ANALYTICS_RETENTION_DAYS=30